# FastAPI + SQLAlchemy (MySQL). Copy to .env and set your local values.
APP_NAME=JobContact
DEBUG=false
DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/job_contact_db
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
UPLOAD_DIR=uploads/
ADMIN_EMAIL=admin@jobcontact.vn
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Quản trị viên

# Optional SMTP. Without SMTP, email verification/reset delivery is unavailable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_STARTTLS=true
SMTP_SSL=false
FRONTEND_URL=http://localhost:5500
CORS_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500"]

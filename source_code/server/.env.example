# FastAPI + SQLAlchemy (MySQL). Copy to .env and set your local values.
APP_NAME=JobContact
DEBUG=false
DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/job_contact_db
# Aiven: enable TLS and use the CA Certificate downloaded from the service.
DATABASE_SSL=false
DATABASE_SSL_CA=
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
UPLOAD_DIR=uploads/
SERVE_FRONTEND=false
# Optional additional frontend origins; FRONTEND_URL is always allowed.
CORS_ORIGINS=[]
ADMIN_EMAIL=admin@jobcontact.vn
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Quản trị viên

# Optional SMTP. Without SMTP, email verification/reset delivery is unavailable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_STARTTLS=true
SMTP_SSL=false
# Local frontend origin; also controls the CORS allowlist and email links.
# On Render: FRONTEND_URL=https://vieco-frontend.onrender.com
FRONTEND_URL=http://localhost:5500

# Optional: "Tạo CV bằng AI" in the CV builder (Claude API key from https://console.anthropic.com).
# Leave empty to disable only the AI button; the CV builder itself still works.
ANTHROPIC_API_KEY=
AI_CV_MODEL=claude-opus-5-5
# The chat bubble (AI assistant) uses the same key; leave the key empty to hide the bubble.
AI_CHAT_MODEL=claude-haiku-5-5
